      "writtenOn": "2015-04-09T15:13:17Z",
      "side": 1,
      "message": "I struggle a little bit with whether you need a full fledged PersistenceComponent, or just use PropertiesComponent if what you want is to save an array of strings. Using PropertiesComponent would have eliminated most of this class and the registration in plugin.xml.\n\nThat said, this would be the right approach if everything else about run configurations was already being saved in runConfigurations.xml and we are just piggy backing on top of the same file.",
      "range": {
        "startLine": 32,
        "startChar": 1,
        "endLine": 32,
        "endChar": 6
      },
      "revId": "c603cae6058cd8d41d737a6d1134d3aa8fa144f9",
