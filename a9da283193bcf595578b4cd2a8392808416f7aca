        "id": 1045657
      },
      "writtenOn": "2014-07-31T00:19:40Z",
      "side": 1,
      "message": "This doesn\u0027t quite make sense to me. If you don\u0027t have enough space to fit all the components, you\u0027ll have them overlap in a random place in the middle of the toolbar. I don\u0027t think that\u0027s the best behavior in that situation.",
      "parentUuid": "b6016bf5_2ffad1d9",
      "revId": "a9da283193bcf595578b4cd2a8392808416f7aca",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
