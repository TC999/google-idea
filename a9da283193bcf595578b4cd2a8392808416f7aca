    {
      "key": {
        "uuid": "f6204393_c4934896",
        "filename": "platform/platform-impl/src/com/intellij/openapi/actionSystem/impl/ActionToolbarImpl.java",
        "patchSetId": 1
      },
      "lineNbr": 778,
      "author": {
        "id": 1050224
      },
      "writtenOn": "2014-07-31T12:03:11Z",
      "side": 1,
      "message": "Actually that is what its avoiding.  If wrap is off, then we don\u0027t want them overlapping when there isn\u0027t enough space, so we break and leave them left aligned, cutting off.  The main toolbar has wrap on.  The nav toolbar has wrap off, but the toolbar itself is right aligned.\nThis condition is there to prevent any right align action that would mistakenly move the component left of where it is now.",
      "parentUuid": "f974b47c_a20ba945",
      "revId": "a9da283193bcf595578b4cd2a8392808416f7aca",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
